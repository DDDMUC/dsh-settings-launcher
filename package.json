{
  "name": "dsh-settings-launcher",
  "version": "0.0.6",
  "description": "侧栏设置入口的两个独立开关：悬浮自动展开原版菜单、点击直达设置；可单选也可全开，全关即官方原样。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "settings",
    "sidebar",
    "account-menu"
  ],
  "author": "DDDMUC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDDMUC/dsh-settings-launcher.git"
  },
  "homepage": "https://github.com/DDDMUC/dsh-settings-launcher#readme",
  "bugs": {
    "url": "https://github.com/DDDMUC/dsh-settings-launcher/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-settings-account"
      ]
    }
  }
}
